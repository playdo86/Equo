---
/**
 * Logo ÉQUO : oiseau redessiné en vectoriel d'après le logo fourni,
 * + mot-symbole « EQUO. » avec le point jaune.
 */
interface Props {
  variant?: 'horizontal' | 'mark';
  tone?: 'couleur' | 'clair';
  class?: string;
}
const { variant = 'horizontal', tone = 'couleur', class: className = '' } = Astro.props;
const word = tone === 'clair' ? 'text-creme' : 'text-lagon';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    viewBox="0 0 106 90"
    class={variant === 'mark' ? 'h-full w-auto' : 'h-9 w-auto sm:h-10'}
    aria-hidden="true"
    focusable="false"
  >
    <g fill="none" stroke="#C9A96E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <!-- queue -->
      <path d="M22 47 C 14 46.5, 8 47, 3.5 48.5 C 9 57, 19 62.5, 31 63.5" fill="#FFFCF5" />
      <path d="M8 50.5 C 14 55, 20 58, 26 59.5" stroke-width="1.4" opacity=".7" />
      <!-- pattes -->
      <path d="M57 69.5 L 58 82 M 53 86 L 58 82 L 62.5 86" />
      <path d="M70 68 L 68 79.5 M 64 83 L 68 79.5 L 72.5 82.5" />
      <!-- corps -->
      <circle cx="53" cy="36.5" r="34" fill="#FFFCF5" />
      <!-- bec -->
      <path d="M102 24.5 L 64 29.5 L 102 32.5" />
    </g>
    <ellipse cx="56.5" cy="17" rx="2.6" ry="3.1" fill="#C9A96E" />
    <ellipse cx="66.5" cy="17" rx="2.6" ry="3.1" fill="#C9A96E" />
  </svg>
  {
    variant === 'horizontal' && (
      <span class:list={['font-logo text-[1.7rem] leading-none tracking-[0.04em] sm:text-[1.9rem]', word]}>
        EQUO<span class="text-soleil">.</span>
      </span>
    )
  }
</span>

<style>
  .font-logo {
    font-family: var(--font-texte);
    font-weight: 900;
  }
</style>
