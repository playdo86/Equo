---
/**
 * Formulaire HelloAsso intégré à la page.
 * Chargé uniquement à la demande du visiteur : aucune connexion à HelloAsso
 * (ni cookie tiers) tant qu'il n'a pas cliqué.
 */
import { helloasso, type HelloAssoKey } from '@/config/site';

interface Props {
  cle: HelloAssoKey;
  titre: string;
  id: string;
}
const { cle, titre, id } = Astro.props;
const lien = helloasso[cle];
---

{
  lien.widgetUrl && (
    <div id={id} class="ha-widget scroll-mt-24 rounded-[var(--radius-carte)] bg-creme p-6 shadow-relief ring-1 ring-sable sm:p-9" data-widget-url={lien.widgetUrl} data-titre={titre}>
      <div data-ha-placeholder class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-2xl font-medium">{titre}</h2>
          <p class="mt-2 max-w-xl text-[0.95rem] text-anthracite/80">
            Paiement sécurisé par HelloAsso, la plateforme de paiement des associations. Le formulaire s’affiche ici, sans quitter le site.
          </p>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-2">
          <button type="button" data-ha-charger class="inline-flex items-center gap-2 rounded-full bg-foret px-7 py-3.5 font-extrabold text-creme shadow-douce transition hover:-translate-y-px hover:bg-foret-sombre">
            Afficher le formulaire
          </button>
          {lien.url && (
            <a href={lien.url} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-foret underline underline-offset-4">
              ou ouvrir sur HelloAsso<span class="sr-only"> (nouvel onglet)</span>
            </a>
          )}
        </div>
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.ha-widget').forEach((zone) => {
    const charger = () => {
      if (zone.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = zone.dataset.widgetUrl!;
      iframe.title = `${zone.dataset.titre} — formulaire HelloAsso`;
      iframe.setAttribute('allow', "payment 'self' https://paymenthub.helloassopay.com https://helloasso.com");
      iframe.style.cssText = 'width:100%;height:750px;border:none;';
      zone.querySelector('[data-ha-placeholder]')?.replaceWith(iframe);
      // HelloAsso envoie la hauteur réelle du formulaire : on ajuste l'iframe.
      window.addEventListener('message', (e) => {
        if (!/(^|\.)helloasso\.com$/.test(new URL(e.origin).hostname)) return;
        if (e.source !== iframe.contentWindow) return;
        const h = Number(e.data?.height);
        if (h > 0) iframe.style.height = `${h}px`;
      });
      iframe.focus();
    };
    zone.querySelector('[data-ha-charger]')?.addEventListener('click', charger);
    // Lien direct vers l'ancre (ex. bouton « Adhérer à ÉQUO ») : on affiche le formulaire.
    if (location.hash === `#${zone.id}`) charger();
    window.addEventListener('hashchange', () => location.hash === `#${zone.id}` && charger());
  });
</script>
