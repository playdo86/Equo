---
/**
 * Portrait d'un membre de l'équipe.
 * - « compact » : trombinoscope de l'accueil (photo, nom, rôle).
 * - « complet » : carte de la page Qui sommes-nous (avec métier, phrase, présentation).
 */
import type { Membre } from '@/config/site';
import { u } from '@/lib/url';

interface Props {
  membre: Membre;
  variante?: 'compact' | 'complet';
}
const { membre: m, variante = 'complet' } = Astro.props;
const initiales = m.nom
  ? m.nom
      .split(/\s+/)
      .map((x) => x[0])
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : null;
const taille = variante === 'compact' ? 'h-24 w-24 text-2xl' : 'h-32 w-32 text-3xl';
/** Présentation découpée en paragraphes (ligne vide = nouveau paragraphe), apostrophes typographiques. */
const paragraphes = (m.presentation ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim().replace(/'/g, '’').replace(/\u0022([^\u0022]*)\u0022/g, '« $1 »'))
  .filter(Boolean);
const phrase = m.phrase ? m.phrase.replace(/'/g, '’') : null;
// Le point du visage sert à la fois de position et de centre du zoom : il reste au même endroit dans le cercle.
const { x, y, zoom } = m.cadrage;
const styleCadrage = `object-position:${x}% ${y}%;transform-origin:${x}% ${y}%;transform:scale(${zoom})`;
---

<div class:list={['flex flex-col items-center text-center', variante === 'complet' && 'h-full rounded-[var(--radius-carte)] bg-creme p-6 shadow-douce ring-1 ring-sable sm:p-7']}>
  {
    m.photo ? (
      <span class:list={['block overflow-hidden rounded-full bg-sable shadow-douce ring-4 ring-creme', taille]}>
        <img src={u(m.photo)} alt={m.nom ? `Portrait de ${m.nom}` : m.role} loading="lazy" class="h-full w-full object-cover" style={styleCadrage} />
      </span>
    ) : (
      <span class:list={['grid place-items-center rounded-full bg-sauge-clair font-titre text-foret shadow-douce ring-4 ring-creme', taille]} aria-hidden="true">
        {initiales ?? (
          <svg viewBox="0 0 24 24" class="h-1/3 w-1/3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="12" cy="8" r="3.5" />
            <path d="M5 20c.8-3.8 3.6-6 7-6s6.2 2.2 7 6" />
          </svg>
        )}
      </span>
    )
  }
  <p class:list={['mt-4 font-titre text-foret-sombre', variante === 'compact' ? 'text-lg' : 'text-xl']}>{m.nom ?? m.role}</p>
  <p class="mt-0.5 text-sm font-bold text-lagon">{m.nom ? m.role : 'Présentation à venir'}</p>
  {variante === 'complet' && m.metier && <p class="mt-1 text-sm text-gris">{m.metier}</p>}
  {variante === 'complet' && phrase && <p class="mt-4 font-titre text-[1.05rem] leading-snug text-anthracite italic">« {phrase} »</p>}
  {
    variante === 'complet' && paragraphes.length > 0 && (
      <div class="mt-4 w-full border-t border-sable pt-4 text-left text-sm leading-relaxed text-anthracite/85">
        <div class="space-y-3">{paragraphes.map((p) => <p>{p}</p>)}</div>
      </div>
    )
  }
</div>

