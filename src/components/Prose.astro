---
interface Props { title: string; metaTitle: string; description: string; noindex?: boolean }
import BaseLayout from '@/layouts/BaseLayout.astro';
const { title, metaTitle, description, noindex } = Astro.props;
---
<BaseLayout title={metaTitle} description={description} noindex={noindex}>
  <article class="container-equo max-w-3xl py-16 sm:py-24">
    <h1 class="text-4xl leading-tight font-medium sm:text-5xl">{title}</h1>
    <div class="prose-equo mt-10"><slot /></div>
  </article>
</BaseLayout>
<style>
  .prose-equo :global(h2) { font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: .75rem; }
  .prose-equo :global(p), .prose-equo :global(li) { line-height: 1.75; color: rgb(40 51 46 / .88); }
  .prose-equo :global(p + p) { margin-top: .9rem; }
  .prose-equo :global(ul) { margin-top: .5rem; padding-left: 1.2rem; list-style: disc; }
  .prose-equo :global(a) { color: var(--color-foret); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .prose-equo :global(.a-completer) { background: #f6eccf; padding: 0 .3em; border-radius: 4px; font-weight: 700; }
</style>
