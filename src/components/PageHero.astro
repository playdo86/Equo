---
/** En-tête commun des pages intérieures. */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="relative overflow-hidden bg-gradient-to-b from-sable-clair to-creme">
  <svg class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 text-sauge opacity-25" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="40" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="100" cy="100" r="68" fill="none" stroke="currentColor" stroke-width="1.2" />
    <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1" />
  </svg>
  <div class:list={['container-equo relative grid gap-10 pb-14 pt-12 sm:pb-20 sm:pt-16', hasAside && 'lg:grid-cols-12 lg:items-center']}>
    <div class={hasAside ? 'lg:col-span-7' : ''}>
      <p class="eyebrow reveal"><span>{eyebrow}</span></p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl leading-[1.1] font-medium sm:text-5xl lg:text-[3.4rem]" style="--delai:80ms" set:html={title} />
      {lead && <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-anthracite/85 sm:text-xl" style="--delai:160ms">{lead}</p>}
      <slot />
    </div>
    {hasAside && <div class="reveal lg:col-span-5" style="--delai:200ms"><slot name="aside" /></div>}
  </div>
</section>
