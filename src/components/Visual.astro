---
/**
 * Emplacement photo.
 *
 * - Si `src` est fourni (photo réelle importée), l'image est optimisée par Astro.
 * - Sinon, une composition graphique aux couleurs d'ÉQUO occupe la place,
 *   accompagnée (optionnellement) d'un repère « Photo à venir » décrivant
 *   la photographie attendue. Aucune photo de banque d'images n'est simulée.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';
import { u } from '@/lib/url';

interface Props {
  motif: 'hero' | 'mouvement' | 'emotions' | 'education' | 'territoire';
  /** Description de la photographie attendue (sert aussi de texte alternatif). */
  attendu: string;
  /** Image importée (optimisée) ou chemin d'une image déposée via l'administration. */
  src?: ImageMetadata | string;
  alt?: string;
  class?: string;
  /** Ratio CSS, ex. '4 / 5' */
  ratio?: string;
  priority?: boolean;
  /** Position du repère « Photo à venir ». */
  hint?: 'haut' | 'bas';
}
const { motif, attendu, src, alt, class: className = '', ratio = '4 / 3', priority = false, hint = 'bas' } = Astro.props;
---

<figure class:list={['relative overflow-hidden rounded-[var(--radius-carte)]', className]} style={`aspect-ratio:${ratio}`}>
  {
    typeof src === 'string' ? (
      <img
        src={u(src)}
        alt={alt ?? attendu}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : src ? (
      <Image
        src={src}
        alt={alt ?? attendu}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        loading={priority ? 'eager' : 'lazy'}
        class="h-full w-full object-cover"
      />
    ) : (
      <>
        <div class:list={['visuel absolute inset-0', `visuel--${motif}`]} aria-hidden="true">
          <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" class="h-full w-full">
            {motif === 'hero' && (
              <g>
                <circle cx="300" cy="78" r="38" fill="#E2CF6E" opacity=".85" />
                <path d="M0 210 C 80 170, 150 175, 220 200 S 340 230, 400 190 V300 H0Z" fill="#8DAA9D" opacity=".55" />
                <path d="M0 245 C 90 215, 170 225, 250 245 S 360 260, 400 240 V300 H0Z" fill="#5C9187" opacity=".7" />
                <path d="M30 262 C 120 240, 200 250, 280 268" stroke="#FAF9F6" stroke-width="2" fill="none" stroke-dasharray="2 9" stroke-linecap="round" />
                <path d="M60 120 C 110 100, 150 140, 200 118 S 290 100, 330 128" stroke="#C9A96E" stroke-width="2.2" fill="none" stroke-linecap="round" />
                <path d="M60 140 C 110 120, 150 160, 200 138 S 290 120, 330 148" stroke="#C9A96E" stroke-width="1.4" fill="none" opacity=".6" stroke-linecap="round" />
              </g>
            )}
            {motif === 'mouvement' && (
              <g>
                <path d="M0 230 C 90 200, 160 215, 240 235 S 360 250, 400 220 V300 H0Z" fill="#8DAA9D" opacity=".6" />
                <path d="M40 270 C 100 230, 150 200, 210 190 S 320 150, 370 90" stroke="#315D50" stroke-width="2.5" fill="none" stroke-dasharray="1 12" stroke-linecap="round" />
                <circle cx="370" cy="90" r="7" fill="#C9A96E" />
                <circle cx="80" cy="70" r="26" fill="#E2CF6E" opacity=".7" />
              </g>
            )}
            {motif === 'emotions' && (
              <g fill="none" stroke-linecap="round">
                <circle cx="200" cy="150" r="22" fill="#E2CF6E" opacity=".75" stroke="none" />
                <circle cx="200" cy="150" r="52" stroke="#C9A96E" stroke-width="2" opacity=".9" />
                <circle cx="200" cy="150" r="86" stroke="#5C9187" stroke-width="1.8" opacity=".7" />
                <circle cx="200" cy="150" r="124" stroke="#5C9187" stroke-width="1.4" opacity=".45" />
                <circle cx="200" cy="150" r="168" stroke="#5C9187" stroke-width="1.2" opacity=".25" />
              </g>
            )}
            {motif === 'education' && (
              <g fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M0 250 C 100 230, 300 230, 400 250 V300 H0Z" fill="#8DAA9D" opacity=".55" stroke="none" />
                <path d="M200 245 V150" stroke="#315D50" stroke-width="2.5" />
                <path d="M200 150 C 200 105, 235 82, 280 82 C 280 125, 248 150, 200 150Z" fill="#5C9187" opacity=".55" stroke="#315D50" stroke-width="2" />
                <path d="M200 190 C 200 160, 175 140, 135 140 C 135 172, 162 190, 200 190Z" fill="#8DAA9D" opacity=".7" stroke="#315D50" stroke-width="2" />
                <circle cx="300" cy="200" r="16" fill="#E2CF6E" opacity=".7" stroke="none" />
              </g>
            )}
            {motif === 'territoire' && (
              <g>
                <path d="M0 200 C 70 160, 130 170, 190 190 S 320 210, 400 160 V300 H0Z" fill="#8DAA9D" opacity=".55" />
                <path d="M0 240 C 100 210, 200 230, 280 238 S 370 230, 400 220 V300 H0Z" fill="#5C9187" opacity=".65" />
                {[60, 120, 175, 250, 330].map((x, i) => (
                  <circle cx={x} cy={190 + (i % 2) * 22} r="5" fill="#FAF9F6" stroke="#315D50" stroke-width="2" />
                ))}
                <path d="M60 190 L120 212 L175 190 L250 212 L330 190" stroke="#315D50" stroke-width="1.5" fill="none" stroke-dasharray="3 5" />
              </g>
            )}
          </svg>
        </div>
        <span class="sr-only">{attendu}</span>
        {site.features.showPhotoHints && (
          <figcaption class:list={['absolute left-3 right-3 flex', hint === 'haut' ? 'top-3' : 'bottom-3']}>
            <span class="inline-flex max-w-full items-start gap-1.5 rounded-xl bg-creme/90 px-3 py-1.5 text-[0.72rem] leading-snug font-bold text-gris backdrop-blur-sm">
              <svg viewBox="0 0 24 24" class="mt-px h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="6" width="18" height="14" rx="3" />
                <circle cx="12" cy="13" r="3.5" />
                <path d="M8 6l1.5-2h5L16 6" />
              </svg>
              <span class="line-clamp-2">Photo à venir · {attendu}</span>
            </span>
          </figcaption>
        )}
      </>
    )
  }
</figure>

<style>
  .visuel { background: linear-gradient(160deg, #f4f0e8 0%, #ede7dc 100%); }
  .visuel--hero { background: linear-gradient(170deg, #f6f1e6 0%, #e9e1d1 60%, #dfe8e3 100%); }
  .visuel--mouvement { background: linear-gradient(165deg, #f4f0e8 0%, #dfe8e3 100%); }
  .visuel--emotions { background: radial-gradient(circle at 50% 50%, #faf6ea 0%, #ede7dc 70%); }
  .visuel--education { background: linear-gradient(170deg, #faf6ea 0%, #ede7dc 100%); }
  .visuel--territoire { background: linear-gradient(170deg, #f4f0e8 0%, #e3ebe6 100%); }
</style>
