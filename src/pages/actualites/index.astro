---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import { u } from '@/lib/url';

const actualites = (await getCollection('actualites', (a) => a.data.publie && a.data.visibilite === 'public')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
---

<BaseLayout title="Actualités" description="Les actualités de l'association de prévention ÉQUO, à Mercurey (Saône-et-Loire).">
  <PageHero eyebrow="Actualités" title="Les actualités d’ÉQUO" lead="Nouvelles de l’association, actions menées, événements à venir." />
  <section class="container-equo pb-24">
    {
      actualites.length === 0 ? (
        <div class="rounded-[var(--radius-carte)] bg-sauge-clair p-8 sm:p-12">
          <h2 class="text-2xl font-medium">Aucune actualité pour le moment</h2>
          <p class="mt-3 text-anthracite/85">Les premières nouvelles de l’association seront publiées ici.</p>
          <Button href="/agenda" variant="secondaire" class="mt-6">Voir l’agenda</Button>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {actualites.map((a) => (
            <li>
              <article class="relative flex h-full flex-col overflow-hidden rounded-[var(--radius-carte)] bg-creme shadow-douce ring-1 ring-sable hover:shadow-relief">
                {a.data.photo && <img src={u(a.data.photo)} alt={a.data.photoAlt ?? ''} loading="lazy" class="aspect-[16/10] w-full object-cover" />}
                <div class="flex flex-1 flex-col p-6">
                  <time datetime={a.data.date.toISOString()} class="text-sm font-bold text-or-texte">{fmt.format(a.data.date)}</time>
                  <h2 class="mt-2 text-xl leading-snug font-medium">
                    <a href={u(`/actualites/${a.id}`)} class="after:absolute after:inset-0">{a.data.titre}</a>
                  </h2>
                  <p class="mt-2 text-[0.95rem] text-anthracite/80">{a.data.resume}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
