---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Visual from '@/components/Visual.astro';
import { u } from '@/lib/url';
import { libelleType, libelleDomaine, libelleInscription, formatCreneau, type Activite } from '@/lib/activites';

export async function getStaticPaths() {
  const activites = await getCollection('activites', (a) => a.data.publie);
  return activites.map((a) => ({ params: { id: a.id }, props: { activite: a } }));
}

const { activite: a } = Astro.props as { activite: Activite };
const { Content } = await render(a);
const d = a.data;
const infos: [string, string | undefined][] = [
  ['Public', d.public],
  ['Lieu', d.lieu],
  ['Horaires', d.recurrence],
  ['Intervenant·e', d.intervenant],
  ['Places', d.places ? `${d.places} participants maximum` : undefined],
  ['Tarif', d.tarif],
  ['Conditions d’accès', d.reserveLicencies ? `Réservé aux licencié·es sport-santé. ${d.conditions ?? ''}` : d.conditions],
];
const ouverte = d.inscription.statut === 'ouverte' && d.inscription.helloassoUrl;
---

<BaseLayout title={d.titre} description={d.resume}>
  <article>
    <header class="bg-gradient-to-b from-sable-clair to-creme">
      <div class="container-equo pb-12 pt-10 sm:pt-14">
        <a href={u('/agenda')} class="lien-fleche text-sm"><span aria-hidden="true">←</span> Retour à l’agenda</a>
        <div class="mt-6 flex flex-wrap gap-2 text-xs font-extrabold">
          <span class="rounded-full bg-sauge-clair px-3 py-1 text-foret">{libelleDomaine[d.domaine]}</span>
          <span class="rounded-full bg-sable px-3 py-1 text-anthracite">{libelleType[d.type]}</span>
        </div>
        <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-medium sm:text-5xl">{d.titre}</h1>
        <p class="mt-5 max-w-2xl text-lg text-anthracite/85">{d.resume}</p>
      </div>
    </header>

    <div class="container-equo grid gap-12 pb-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        {d.photo ? <Visual motif="mouvement" src={d.photo} alt={d.photoAlt} attendu={d.photoAlt ?? d.titre} ratio="16 / 9" /> : null}
        <div class="prose-activite mt-8"><Content /></div>
      </div>

      <aside class="lg:col-span-5" aria-label="Informations pratiques">
        <div class="sticky top-24 rounded-[var(--radius-carte)] bg-creme p-7 shadow-relief ring-1 ring-sable">
          <h2 class="text-xl font-medium">Informations pratiques</h2>
          {d.dates.length > 0 && (
            <div class="mt-5">
              <p class="text-sm font-extrabold text-lagon">Dates</p>
              <ul class="mt-2 space-y-1.5">
                {d.dates.map((x) => <li class="flex gap-2 text-[0.95rem]"><Icon name="fleche" class="mt-0.5 h-4 w-4 text-or-texte" />{formatCreneau(x.debut, x.fin)}</li>)}
              </ul>
            </div>
          )}
          <dl class="mt-5 divide-y divide-sable">
            {infos.filter(([, v]) => v).map(([k, v]) => (
              <div class="py-3"><dt class="text-sm font-extrabold text-lagon">{k}</dt><dd class="mt-0.5 text-[0.95rem]">{v}</dd></div>
            ))}
          </dl>
          <p class="mt-5 rounded-xl bg-sable-clair px-4 py-2 text-sm font-extrabold text-foret">{libelleInscription[d.inscription.statut]}</p>
          <div class="mt-5">
            {ouverte ? (
              <a href={d.inscription.helloassoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-foret px-7 py-3.5 font-extrabold text-creme hover:bg-foret-sombre">
                S’inscrire sur HelloAsso<span class="sr-only"> (nouvel onglet)</span>
              </a>
            ) : (
              <Button href="/contact?type=participer" variant="secondaire" class="w-full">Poser une question</Button>
            )}
          </div>
          <p class="mt-5 text-xs text-gris">Activité de prévention et de bien-être : elle ne remplace pas un suivi médical.</p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-activite :global(h2) { font-size: 1.5rem; margin: 2rem 0 .75rem; }
  .prose-activite :global(p), .prose-activite :global(li) { line-height: 1.75; color: rgb(40 51 46 / .88); }
  .prose-activite :global(p + p) { margin-top: .9rem; }
  .prose-activite :global(ul) { list-style: disc; padding-left: 1.2rem; margin-top: .5rem; }
</style>
