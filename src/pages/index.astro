---
import { getCollection } from 'astro:content';
import { u } from '@/lib/url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Visual from '@/components/Visual.astro';
import Trombine from '@/components/Trombine.astro';
import { site, bureau, tarifs } from '@/config/site';
import { domaines } from '@/data/domaines';
import accueil from '@/data/reglages/accueil.json';
import { photo } from '@/lib/photos';

const pourquoi = accueil.pourquoi.filter((p) => p.trim());
const photoAccueil = photo('accueil');
const actualites = (await getCollection('actualites', (a) => a.data.publie && a.data.visibilite === 'public'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmtDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });

/** Les 4 façons de s'engager : un verbe par action, identique partout sur le site. */
const engagements = [
  { icone: 'mouvement', titre: 'Participer', texte: 'Ateliers, séances et événements ouverts à tous, à son rythme.', lien: '/agenda', action: 'Voir l’agenda' },
  { icone: 'personne', titre: 'Adhérer', texte: `Devenir membre (${tarifs.adhesion.montant} € par an) ou s’inscrire à la pratique sport-santé.`, lien: '/adherer', action: 'Adhérer' },
  { icone: 'coeur', titre: 'Faire un don', texte: 'Soutenir des actions de prévention accessibles à tous.', lien: '/soutenir', action: 'Faire un don' },
  { icone: 'structure', titre: 'Devenir partenaire', texte: 'Collectivités, structures de santé, entreprises : agir ensemble sur votre territoire.', lien: '/partenaires', action: 'Construire un partenariat' },
] as const;
---

<BaseLayout description="ÉQUO, association de prévention et sport-santé à Mercurey (Saône-et-Loire) : mouvement, régulation émotionnelle et modes de vie, à son rythme.">
  <!-- ============================================ 1. CONSTRUIRE LES ÉQUILIBRES -->
  <section class="relative overflow-hidden" aria-labelledby="hero-titre">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-full bg-gradient-to-b from-sable-clair to-creme"></div>
    <div class="container-equo grid items-center gap-12 pb-16 pt-10 sm:pt-14 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-20">
      <div class="lg:col-span-6">
        <p class="eyebrow reveal"><span>Association de prévention<span class="hidden sm:inline">&nbsp;· {site.contact.region}</span></span></p>
        <h1 id="hero-titre" class="reveal mt-5 text-[2.6rem] leading-[1.05] font-medium sm:text-6xl lg:text-[4.1rem]" style="--delai:80ms">
          {accueil.heroTitre} <em class="font-normal italic text-lagon">{accueil.heroTitreAccent}</em>
        </h1>
        <p class="reveal mt-6 font-titre text-xl text-foret sm:text-2xl" style="--delai:160ms">
          {accueil.heroSignature.split(/(?<=\.)\s+/).map((mot) => <span class="signature">{mot} </span>)}
          <span class="mt-1 block text-lg italic text-gris sm:text-xl">{accueil.heroSousSignature}</span>
        </p>
        <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-anthracite/85" style="--delai:240ms">{accueil.heroTexte}</p>
        <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row" style="--delai:320ms">
          <Button href="/actions" size="lg">
            Découvrir nos actions
            <Icon name="fleche" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </Button>
          <Button href="/adherer" size="lg" variant="secondaire">Adhérer</Button>
        </div>
      </div>
      <div class="relative lg:col-span-6">
        <div class="reveal relative mx-auto max-w-xl lg:ml-auto" style="--delai:200ms">
          <div class="absolute -left-6 -top-6 hidden h-40 w-40 rounded-full bg-sauge-clair sm:block" aria-hidden="true"></div>
          <Visual
            motif="hero"
            ratio="5 / 6"
            priority
            hint="haut"
            src={photoAccueil.src}
            alt={photoAccueil.alt}
            attendu="Personnes d’âges différents qui marchent ensemble en extérieur, lumière naturelle"
            class="shadow-relief relative"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ 2. POURQUOI ÉQUO -->
  <section class="py-20 sm:py-24" aria-labelledby="pourquoi-titre">
    <div class="container-equo">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 id="pourquoi-titre" class="reveal text-3xl leading-tight font-medium sm:text-4xl">{accueil.pourquoiTitre}</h2>
          <ul class="mt-8 space-y-5">
            {pourquoi.map((phrase, i) => (
              <li class="reveal flex gap-4" style={`--delai:${i * 80}ms`}>
                <span class="mt-3.5 h-px w-6 shrink-0 bg-or" aria-hidden="true" />
                <p class="text-lg leading-relaxed text-anthracite/90">{phrase}</p>
              </li>
            ))}
          </ul>
          <p class="reveal mt-8 border-l-4 border-sauge pl-5 text-lg font-extrabold text-foret sm:text-xl">{accueil.pourquoiConclusion}</p>
        </div>
        <div class="grid content-start gap-5 lg:col-span-5 lg:col-start-8">
          <div class="reveal rounded-[var(--radius-carte)] bg-sauge-clair p-6 sm:p-7">
            <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-lagon">ÉQUO, comme</p>
            <p class="mt-2 font-titre text-2xl text-foret-sombre"><em class="italic">équilibre</em></p>
            <p class="mt-1 text-anthracite/85">{accueil.equilibre}</p>
          </div>
          <div class="reveal rounded-[var(--radius-carte)] bg-sable p-6 sm:p-7" style="--delai:100ms">
            <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-or-texte">ÉQUO, comme</p>
            <p class="mt-2 font-titre text-2xl text-foret-sombre"><em class="italic">écho</em></p>
            <p class="mt-1 text-anthracite/85">{accueil.echo}</p>
          </div>
        </div>
      </div>

      <div class="reveal mt-16 rounded-[var(--radius-carte)] bg-sable-clair p-7 sm:p-10">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <h3 class="text-2xl font-medium sm:text-3xl">{accueil.equipeTitre}</h3>
          <a href={u('/qui-sommes-nous#equipe')} class="lien-fleche shrink-0">Qui sommes-nous <Icon name="fleche" class="h-4 w-4" /></a>
        </div>
        <ul class="mt-8 flex flex-wrap justify-center gap-x-10 gap-y-8 sm:justify-start">
          {bureau.map((m) => (
            <li class="w-36"><Trombine membre={m} variante="compact" /></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================ 3. CE QUE NOUS FAISONS -->
  <section class="bg-sable-clair py-20 sm:py-24" aria-labelledby="domaines-titre">
    <div class="container-equo">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <h2 id="domaines-titre" class="reveal max-w-2xl text-3xl leading-tight font-medium sm:text-4xl">Ce que nous faisons</h2>
        <a href={u('/actions')} class="lien-fleche reveal shrink-0">Toutes nos actions <Icon name="fleche" class="h-4 w-4" /></a>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {domaines.map((d, i) => (
          <li class="reveal" style={`--delai:${i * 100}ms`}>
            <article class="carte group relative flex h-full flex-col overflow-hidden rounded-[var(--radius-carte)] bg-creme shadow-douce transition-shadow duration-300 hover:shadow-relief">
              <Visual motif={d.motif} attendu={d.photo} src={photo(d.id).src} alt={photo(d.id).alt} ratio="16 / 10" class="rounded-none" />
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-sauge-clair text-foret"><Icon name={d.icone} class="h-5 w-5" /></span>
                <h3 class="mt-4 text-2xl leading-snug font-medium">
                  <a href={u(`/actions#${d.id}`)} class="after:absolute after:inset-0 focus-visible:outline-none">{d.titre}</a>
                </h3>
                <p class="mt-3 text-anthracite/80">{d.accroche}</p>
                <span class="lien-fleche mt-auto pt-6" aria-hidden="true">En savoir plus <Icon name="fleche" class="h-4 w-4" /></span>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {
    actualites.length > 0 && (
      <section class="py-20" aria-labelledby="actus-titre">
        <div class="container-equo">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <h2 id="actus-titre" class="reveal text-3xl leading-tight font-medium sm:text-4xl">Actualités</h2>
            <a href={u('/actualites')} class="lien-fleche reveal shrink-0">Toutes les actualités <Icon name="fleche" class="h-4 w-4" /></a>
          </div>
          <ul class="mt-10 grid gap-6 md:grid-cols-3">
            {actualites.map((a) => (
              <li class="reveal">
                <article class="relative flex h-full flex-col rounded-[var(--radius-carte)] bg-creme p-6 shadow-douce ring-1 ring-sable hover:shadow-relief">
                  <time datetime={a.data.date.toISOString()} class="text-sm font-bold text-or-texte">{fmtDate.format(a.data.date)}</time>
                  <h3 class="mt-2 text-xl leading-snug font-medium"><a href={u(`/actualites/${a.id}`)} class="after:absolute after:inset-0">{a.data.titre}</a></h3>
                  <p class="mt-2 text-[0.95rem] text-anthracite/80">{a.data.resume}</p>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============================================ 4. S'ENGAGER -->
  <section class="py-20 sm:py-24" aria-labelledby="engager-titre">
    <div class="container-equo">
      <h2 id="engager-titre" class="reveal max-w-2xl text-3xl leading-tight font-medium sm:text-4xl">S’engager avec ÉQUO</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {engagements.map((e, i) => {
          const sombre = e.lien === '/partenaires';
          return (
            <li class="reveal" style={`--delai:${i * 80}ms`}>
              <article class:list={['group relative flex h-full flex-col rounded-[var(--radius-carte)] p-6 transition hover:-translate-y-0.5 hover:shadow-relief sm:p-7', sombre ? 'bg-foret text-creme' : 'bg-creme shadow-douce ring-1 ring-sable']}>
                <span class:list={['grid h-12 w-12 place-items-center rounded-full', sombre ? 'bg-creme/10 text-or ring-1 ring-creme/20' : 'bg-sauge-clair text-foret']}>
                  <Icon name={e.icone} class="h-6 w-6" />
                </span>
                <h3 class:list={['mt-5 text-2xl font-medium', sombre && 'text-creme']}>
                  <a href={u(e.lien)} class="after:absolute after:inset-0">{e.titre}</a>
                </h3>
                <p class:list={['mt-2 text-[0.95rem] leading-relaxed', sombre ? 'text-creme/85' : 'text-anthracite/80']}>{e.texte}</p>
                <span class:list={['mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-extrabold', sombre ? 'text-creme' : 'text-foret']} aria-hidden="true">
                  {e.action} <Icon name="fleche" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                </span>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .signature { white-space: nowrap; }
  .carte:focus-within { box-shadow: var(--shadow-relief); outline: 3px solid var(--color-or-texte); outline-offset: 3px; }
</style>
