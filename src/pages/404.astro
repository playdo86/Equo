---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---
<BaseLayout title="Page introuvable" noindex>
  <section class="container-equo py-24 text-center sm:py-32">
    <p class="eyebrow justify-center">Erreur 404</p>
    <h1 class="mt-4 text-4xl font-medium sm:text-5xl">Cette page s'est un peu déséquilibrée.</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-anthracite/80">La page demandée n'existe pas ou a été déplacée.</p>
    <div class="mt-9 flex justify-center"><Button href="/" size="lg">Retour à l'accueil</Button></div>
  </section>
</BaseLayout>
