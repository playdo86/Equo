---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { principesApproche, rigueur } from '@/data/association';

const etapes = ['Expérimenter', 'Ressentir', 'Ajuster', 'Choisir', 'S’approprier'];
---

<BaseLayout
  title="Notre approche"
  description="Santé positive, pouvoir d'agir, expérience avant discours, accessibilité et ancrage territorial : les cinq principes qui guident les actions de prévention d'ÉQUO."
>
  <PageHero
    eyebrow="Notre approche"
    title="Une autre manière de faire <em class='italic text-lagon'>de la prévention</em>"
    lead="Plutôt que de transmettre des prescriptions ou des modèles à suivre, nous créons les conditions pour que chacun puisse expérimenter, ajuster, faire des choix réalistes et construire ses propres équilibres, à son rythme."
  >
    <ol class="reveal mt-10 flex flex-wrap items-center gap-x-2 gap-y-3" style="--delai:240ms" aria-label="Le cheminement proposé">
      {etapes.map((e, i) => (
        <li class="flex items-center gap-2">
          <span class="rounded-full bg-creme px-4 py-2 font-extrabold text-foret shadow-douce">{e}</span>
          {i < etapes.length - 1 && <Icon name="fleche" class="h-4 w-4 text-or-texte" />}
        </li>
      ))}
    </ol>
  </PageHero>

  <section class="py-20 sm:py-24" aria-labelledby="principes-titre">
    <div class="container-equo">
      <h2 id="principes-titre" class="reveal max-w-2xl text-3xl font-medium sm:text-4xl">Cinq principes, appliqués à chaque action</h2>
      <ol class="mt-12 space-y-6">
        {principesApproche.map((p, i) => (
          <li id={p.id} class="reveal scroll-mt-24">
            <article class="grid gap-6 rounded-[var(--radius-carte)] bg-creme p-7 shadow-douce ring-1 ring-sable sm:p-9 lg:grid-cols-12 lg:gap-10">
              <div class="flex items-start gap-5 lg:col-span-5">
                <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-foret text-creme">
                  <Icon name={p.icone} class="h-7 w-7" />
                </span>
                <div>
                  <p class="font-titre text-sm text-or-texte">Principe {i + 1}</p>
                  <h3 class="mt-1 text-2xl leading-snug font-medium">{p.titre}</h3>
                </div>
              </div>
              <div class="lg:col-span-7">
                <p class="leading-relaxed text-anthracite/85">{p.texte}</p>
                <p class="mt-4 rounded-2xl bg-sauge-clair p-4 text-[0.95rem] leading-relaxed text-foret-sombre">
                  <strong class="font-extrabold">Concrètement :</strong> {p.concret}
                </p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-sable-clair py-20 sm:py-24" aria-labelledby="rigueur-titre">
    <div class="container-equo">
      <div class="max-w-3xl">
        <p class="eyebrow reveal"><span>Rigueur</span></p>
        <h2 id="rigueur-titre" class="reveal mt-4 text-3xl leading-tight font-medium sm:text-4xl">Accessible, mais exigeant</h2>
        <p class="reveal mt-5 text-lg leading-relaxed text-anthracite/85">
          Une approche simple dans la forme, rigoureuse dans le fond. ÉQUO s’engage dans une démarche de qualité fondée
          sur les connaissances scientifiques et l’expérience de terrain.
        </p>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {rigueur.map((r, i) => (
          <li class="reveal rounded-[var(--radius-carte)] bg-creme p-7" style={`--delai:${i * 80}ms`}>
            <span class="block h-[3px] w-12 rounded-full bg-or" aria-hidden="true" />
            <h3 class="mt-5 text-xl font-medium">{r.titre}</h3>
            <p class="mt-3 leading-relaxed text-anthracite/80">{r.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20 sm:py-24" aria-labelledby="cadre-titre">
    <div class="container-equo grid gap-10 lg:grid-cols-12">
      <h2 id="cadre-titre" class="reveal text-3xl leading-tight font-medium sm:text-4xl lg:col-span-5">Un cadre clair, en complémentarité du soin</h2>
      <div class="reveal space-y-4 leading-relaxed text-anthracite/85 lg:col-span-7">
        <p>
          ÉQUO intervient en complémentarité des parcours de soins existants et des professionnels de santé, dans le respect
          du cadre réglementaire en vigueur. Les actions d’éducation thérapeutique et d’activité physique sur prescription
          sont menées en lien avec des professionnels ou structures habilités.
        </p>
        <p>
          L’écoute, l’orientation et l’accompagnement progressif sont présents au cœur de chaque mise en pratique. Si
          nécessaire, nous orientons vers des ressources complémentaires, dans le respect du rythme des personnes.
        </p>
        <p class="rounded-2xl bg-sable p-4 text-[0.95rem] font-bold text-anthracite">
          Les activités proposées relèvent de la prévention et du bien-être. Elles ne remplacent pas un suivi médical,
          paramédical ou thérapeutique.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Découvrez comment ces principes prennent forme"
    primary={{ label: 'Nos actions', href: '/actions' }}
    secondary={{ label: 'Construire un partenariat', href: '/partenaires' }}
  />
</BaseLayout>
